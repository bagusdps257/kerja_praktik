# ==============================================================================
# OCR DOCUMENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi `.env` di server dan sesuaikan nilainya:
#   cp .env.example .env
# ==============================================================================

# 1. Kunci Rahasia Session (Wajib diganti dengan string acak panjang di production)
# Contoh generate di terminal: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ocr_project_secret_key_2026_super_secure

# 2. Mode Debugging (Set 'false' di server production, 'true' hanya untuk dev lokal)
FLASK_DEBUG=false

# 3. Kontrol Pendaftaran Pengguna Baru (false = registrasi publik ditutup)
ALLOW_REGISTRATION=false

# 4. Koneksi Database MySQL
# Format: mysql+pymysql://<user>:<password>@<host>/<database_name>
DATABASE_URL=mysql+pymysql://root:@localhost/ocr_database

# 5. Lokasi Binary Executable Tesseract OCR
# Ubuntu Linux default: /usr/bin/tesseract
# Windows (opsional): C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
